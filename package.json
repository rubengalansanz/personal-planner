{
  "name": "personal-planner",
  "version": "0.2.0",
  "description": "Personal Planner de escritorio — calendario, tareas, contactos y notas",
  "author": {
    "name": "Rubén Galán",
    "email": "ruben.galansanz@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "electron:build:ts": "tsc -p electron/tsconfig.json",
    "electron:dev": "npm run electron:build:ts && concurrently \"next dev -p 3456\" \"wait-on http://localhost:3456/calendario && electron .\"",
    "electron:preview": "npm run build && npm run electron:build:ts && electron .",
    "electron:dist": "npm run build && npm run electron:build:ts && electron-builder",
    "postbuild": "node scripts/standalone-assets.mjs",
    "notify": "node scripts/notify.mjs",
    "typecheck": "tsc --noEmit",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "next": "16.4.4",
    "node-cron": "^4.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.personal.planner",
    "productName": "Personal Planner",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      ".next/**/*",
      "public/**/*",
      "next.config.ts",
      "package.json"
    ],
    "asarUnpack": [
      ".next/standalone/**/*",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "db/migrations",
        "to": "db/migrations"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Office",
      "icon": "build/icons"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "rpm": {
      "packageCategory": "Applications/Office",
      "vendor": "Rubén Galán"
    },
    "msi": {
      "oneClick": false,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": true,
      "runAfterFinish": true
    }
  }
}
