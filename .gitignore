# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build/*
!/build/icon.ico
!/build/icon.icns
!/build/icons/
!/build/icons/*.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.bak

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local sqlite database
agenda.db
agenda.db-shm
agenda.db-wal
*.db
*.db-shm
*.db-wal

# ficheros markdown
agenda-personal.md
GEMINI.md
session-personal-planner-*
mejoras*

# ficheros txt
issues*

# carpetas ocultas
/.claude/
/.codegraph/
/.gemini/
/.atl/

# ficheros ocultos
.gga
.gentle-ai-default-agent.json

# ficheros json
.mcp.json
opencode.jsonc

# artifacts del empaquetado
release/

# artifacts compilados de TS (regenerados con la build de electron)
/electron/*.js
/electron/*.js.map
/lib/data/reminders.js
/lib/data/reminders.js.map
